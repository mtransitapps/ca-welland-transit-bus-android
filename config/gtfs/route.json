{
    "keep_routes": [
        {
            "route_short_name_regex": "^5\\d{2}$",
            "comment": "keep only 3-digit routes starting w/ 5"
        },
        {
            "route_short_name": "751",
            "comment": "include Fort Erie"
        }
    ],
    "exclude_routes": [
        {
            "route_short_name_regex": "^([^5]\\d{2}|\\d{2})$",
            "comment": "keep only 3-digit routes not starting w/ 5"
        }
    ],
    "default_route_id_enabled": true,
    "use_route_short_name_for_route_id": true,
    "default_route_long_name_enabled": true,
    "route_long_name_cleaners": [
        {
            "regex": "((^|\\W)([\\w])\\.(\\W|$))",
            "replacement": "$2$3$4"
        },
        {
            "regex": "((^|\\W)([\\w]+)\\.(\\W|$))",
            "replacement": "$2$3$4"
        }
    ],
    "route_colors_ignored": [
        "053747",
        "042935"
    ],
    "route_colors_comment": "From https://nrtransit.ca/routes/welland/",
